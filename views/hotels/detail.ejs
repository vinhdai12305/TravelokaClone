<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= hotel.name %></title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f7fa;
            color: #333;
            overflow-x: hidden; 
        }

        /* FIX LỖI DÍNH HEADER */
        .main-wrapper {
            max-width: 1100px;
            margin: 160px auto 50px; 
            padding: 0 20px;
        }

        .breadcrumbs {
            font-size: 13px;
            color: #0194f3;
            margin-bottom: 25px;
            font-weight: 600;
            display: block;
        }

        /* Hotel Card */
        .hotel-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 4px 25px rgba(0,0,0,0.07);
            overflow: hidden;
            margin-bottom: 30px;
        }

        /* Gallery Section */
        .gallery-container {
            display: flex;
            gap: 12px;
            padding: 20px;
            height: 480px;
        }

        .img-large {
            flex: 2;
            border-radius: 15px;
            overflow: hidden;
        }

        .img-large img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s;
        }

        .img-grid-small {
            flex: 1.2;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .img-grid-small img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
        }

        .img-large img:hover { transform: scale(1.03); }

        /* Info & Price */
        .info-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding: 0 25px 30px;
        }

        .hotel-title {
            font-size: 28px;
            font-weight: 700;
            color: #03121a;
            margin-bottom: 12px;
        }

        .hotel-tags {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .badge {
            background: #e6f4ff;
            color: #0284c7;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .stars { color: #f59e0b; }

        .price-box { text-align: right; }

        .price-label { font-size: 13px; color: #687176; margin-bottom: 8px; }

        .price-val {
            font-size: 34px;
            font-weight: 800;
            color: #ff5e1f;
            margin-bottom: 15px;
        }

        /* Nút Select Room đã chuyển thành Link hướng sang trang điền thông tin */
        .btn-select {
            display: inline-block;
            text-decoration: none;
            background: #ff5e1f;
            color: white;
            border: none;
            padding: 14px 45px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(255, 94, 31, 0.3);
        }

        .btn-select:hover {
            background: #e04d14;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255, 94, 31, 0.4);
        }

        /* Alert Banner */
        .alert {
            background: #e6f4ff;
            color: #0369a1;
            padding: 18px 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            font-weight: 600;
            border-left: 6px solid #0194f3;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 30px;
            background: #fff;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 4px 25px rgba(0,0,0,0.07);
        }

        .section-title { font-weight: 700; font-size: 19px; margin-bottom: 18px; color: #03121a; }

        .rating-score { font-size: 34px; font-weight: 800; color: #0194f3; }

        .area-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
            border-bottom: 1px dashed #eee;
            padding-bottom: 5px;
        }

        .facility-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .facility-item i { color: #0194f3; width: 20px; text-align: center; }

        @media (max-width: 768px) {
            .main-wrapper { margin-top: 100px; }
            .details-grid { grid-template-columns: 1fr; }
            .gallery-container { height: auto; flex-direction: column; }
            .info-container { flex-direction: column; align-items: flex-start; gap: 20px; }
            .price-box { text-align: left; width: 100%; }
        }
    </style>
</head>

<body>

    <%- include('../partials/header') %>

    <div class="main-wrapper">

        <div class="breadcrumbs">
            <i class="fa fa-map-marker-alt"></i> <%= hotel.location_breadcrumb || 'Hotel / Đà Nẵng' %>
        </div>

        <div class="hotel-card">

            <div class="gallery-container">
                <div class="img-large">
                    <img src="<%= hotel.images?.large || 'https://via.placeholder.com/800x450' %>" alt="Hotel Large">
                </div>
                <div class="img-grid-small">
                    <% if (hotel.images?.small && hotel.images.small.length > 0) { %>
                        <% hotel.images.small.forEach(img => { %>
                            <img src="<%= img %>" alt="Hotel Small">
                        <% }) %>
                    <% } else { %>
                        <img src="https://via.placeholder.com/300" alt="placeholder">
                        <img src="https://via.placeholder.com/300" alt="placeholder">
                        <img src="https://via.placeholder.com/300" alt="placeholder">
                        <img src="https://via.placeholder.com/300" alt="placeholder">
                    <% } %>
                </div>
            </div>

            <div class="info-container">
                <div>
                    <h1 class="hotel-title"><%= hotel.name %></h1>
                    <div class="hotel-tags">
                        <span class="badge"><i class="fa fa-hotel"></i> <%= hotel.type || 'Khách sạn' %></span>
                        <div class="stars">
                            <% for(let i=0; i<5; i++) { %><i class="fa fa-star"></i><% } %>
                        </div>
                    </div>
                </div>

                <div class="price-box">
                    <div class="price-label">Giá phòng/đêm từ</div>
                    <div class="price-val">
  <%= hotel.discountPrice 
      ? hotel.discountPrice.toLocaleString('vi-VN')
      : '0' %> VND
</div>
                    
                    <a href="/hotels/booking-form/<%= hotel._id %>" class="btn-select">
                        Chọn phòng
                    </a>
                </div>
            </div>

        </div>

        <div class="alert">
            <i class="fa fa-bolt" style="color: #ff5e1f;"></i> Nhanh tay lên! Chỉ còn 1 phòng cuối cùng với mức giá này.
        </div>

        <div class="details-grid">

            <div>
                <div class="section-title">Đánh giá khách hàng</div>
                <div class="rating-score"><%= hotel.rating || '9' %>/10</div>
                <div style="font-weight: 700; color: #0194f3; margin-top: 5px;"><%= hotel.rating_text || 'Tuyệt vời' %></div>
                <p style="font-size: 13px; color: #888; margin-top: 10px;">Từ hơn 1,200 đánh giá đã xác thực.</p>
            </div>

            <div>
                <div class="section-title">Khu vực lân cận</div>
                <p style="font-size: 14px; margin-bottom: 12px; color: #666;"><i class="fa fa-map-pin"></i> <%= hotel.address %></p>
                <% if (hotel.nearby && hotel.nearby.length > 0) { %>
                    <% hotel.nearby.forEach(place => { %>
                        <div class="area-item">
                            <span><%= place.name %></span>
                            <span style="color: #0194f3; font-weight: 600;"><%= place.distance %></span>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div>
                <div class="section-title">Tiện nghi chính</div>
                <% if (hotel.facilities && hotel.facilities.length > 0) { %>
                    <% hotel.facilities.forEach(fac => { %>
                        <div class="facility-item">
                            <i class="fa-solid fa-<%= fac.icon || 'circle-check' %>"></i>
                            <span><%= fac.name %></span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="facility-item"><i class="fa fa-wifi"></i> <span>WiFi miễn phí</span></div>
                    <div class="facility-item"><i class="fa fa-swimming-pool"></i> <span>Hồ bơi</span></div>
                    <div class="facility-item"><i class="fa fa-utensils"></i> <span>Nhà hàng</span></div>
                <% } %>
            </div>

        </div>

    </div>

</body>
</html>