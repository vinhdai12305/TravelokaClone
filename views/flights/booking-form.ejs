<%- include('../partials/header') %>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Inter',sans-serif;
}

body{
    background:#f5f7fa;
}

/* WRAPPER */

.booking-wrapper{
    max-width:1250px;
    margin:130px auto 60px;
    padding:0 20px;
}

/* TOP */

.booking-top{
    margin-bottom:30px;
}

.page-title{
    font-size:38px;
    font-weight:800;
    color:#0f172a;
    margin-bottom:10px;
}

.page-sub{
    color:#64748b;
    font-size:15px;
}

/* CONTAINER */

.booking-container{
    display:grid;
    grid-template-columns:1.6fr 1fr;
    gap:28px;
}

/* CARD */

.card{
    background:white;
    border-radius:26px;
    padding:32px;
    box-shadow:
        0 10px 30px rgba(15,23,42,0.05);
    border:1px solid #eef2f7;
}

/* LEFT */

.form-title{
    font-size:30px;
    font-weight:800;
    color:#0f172a;
    margin-bottom:28px;
}

/* INPUT */

.input-group{
    margin-bottom:20px;
}

.label{
    display:block;
    margin-bottom:10px;
    font-size:14px;
    font-weight:700;
    color:#334155;
}

.input{
    width:100%;
    padding:16px 18px;
    border:1.5px solid #dbe4ee;
    border-radius:14px;
    font-size:15px;
    transition:0.25s;
    background:#fcfdff;
}

.input:focus{
    border-color:#0194f3;
    outline:none;
    box-shadow:0 0 0 4px rgba(1,148,243,0.08);
}

/* GRID */

.grid-2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

/* BUTTON */

.pay-btn{
    width:100%;
    border:none;
    background:
        linear-gradient(
            135deg,
            #ff6b2c,
            #ff5e1f
        );
    color:white;
    padding:18px;
    border-radius:16px;
    font-size:18px;
    font-weight:800;
    cursor:pointer;
    margin-top:10px;
    transition:0.25s;
}

.pay-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 20px rgba(255,94,31,0.25);
}

/* RIGHT */

.summary-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:25px;
}

.summary-title{
    font-size:28px;
    font-weight:800;
    color:#0f172a;
}

/* AIRLINE */

.airline-box{
    background:#f8fbff;
    border:1px solid #dbeafe;
    border-radius:18px;
    padding:22px;
    margin-bottom:25px;
}

.airline-name{
    font-size:24px;
    font-weight:800;
    color:#0f172a;
    margin-bottom:8px;
}

.flight-route{
    color:#64748b;
    font-size:15px;
}

/* TIME */

.flight-time-box{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:30px 0;
}

.time{
    font-size:34px;
    font-weight:800;
    color:#0f172a;
}

.airport{
    font-size:15px;
    color:#64748b;
    font-weight:700;
}

.flight-line{
    flex:1;
    height:2px;
    background:#dbeafe;
    margin:0 20px;
    position:relative;
}

.flight-line::after{
    content:'✈';
    position:absolute;
    right:-6px;
    top:-14px;
    color:#0194f3;
    font-size:22px;
}

/* INFO */

.info-row{
    display:flex;
    justify-content:space-between;
    margin-bottom:18px;
    font-size:15px;
}

.info-label{
    color:#64748b;
    font-weight:600;
}

.info-value{
    color:#0f172a;
    font-weight:800;
}

/* PRICE */

.price-box{
    margin-top:28px;
    padding-top:25px;
    border-top:1px dashed #dbe4ee;
}

.price-label{
    color:#64748b;
    font-size:15px;
    margin-bottom:10px;
}

.price{
    color:#ff5e1f;
    font-size:42px;
    font-weight:800;
}

/* TAG */

.tag{
    display:inline-block;
    background:#dcfce7;
    color:#16a34a;
    font-size:13px;
    font-weight:700;
    padding:8px 14px;
    border-radius:999px;
    margin-top:18px;
}

/* RESPONSIVE */

@media(max-width:900px){

    .booking-container{
        grid-template-columns:1fr;
    }

    .grid-2{
        grid-template-columns:1fr;
    }

    .page-title{
        font-size:30px;
    }

}

</style>

<div class="booking-wrapper">

    <!-- TOP -->
    <div class="booking-top">

        <div class="page-title">
            Đặt vé máy bay
        </div>

        <div class="page-sub">
            Hoàn tất thông tin hành khách và xác nhận chuyến bay
        </div>

    </div>

    <!-- CONTAINER -->
    <div class="booking-container">

        <!-- LEFT -->
        <div class="card">

            <div class="form-title">
                Thông tin hành khách
            </div>

            <form action="/flight/book-flight/<%= flight._id %>" method="POST">

                <div class="input-group">

                    <label class="label">
                        Họ tên hành khách
                    </label>

                    <input
                        type="text"
                        name="guestName"
                        placeholder="Ví dụ: Nguyễn Văn A"
                        class="input"
                        required
                    >

                </div>

                <div class="grid-2">

                    <div class="input-group">

                        <label class="label">
                            Email
                        </label>

                        <input
                            type="email"
                            name="email"
                            placeholder="example@gmail.com"
                            class="input"
                            required
                        >

                    </div>

                    <div class="input-group">

                        <label class="label">
                            Số điện thoại
                        </label>

                        <input
                            type="text"
                            name="phone"
                            placeholder="0901234567"
                            class="input"
                            required
                        >

                    </div>

                </div>

                <div class="grid-2">

                    <div class="input-group">

                        <label class="label">
                            Số hành khách
                        </label>

                        <select name="passengers" class="input">

                            <option value="1">
                                1 Hành khách
                            </option>

                            <option value="2">
                                2 Hành khách
                            </option>

                            <option value="3">
                                3 Hành khách
                            </option>

                        </select>

                    </div>

                    <div class="input-group">

                        <label class="label">
                            Hạng ghế
                        </label>

                        <select name="seatClass" class="input">

                            <option value="Economy">
                                Economy
                            </option>

                            <option value="Business">
                                Business
                            </option>

                        </select>

                    </div>

                </div>

                <button type="submit" class="pay-btn">
                    Đặt vé
                </button>

            </form>

        </div>

        <!-- RIGHT -->
        <div class="card">

            <div class="summary-header">

                <div class="summary-title">
                    Chi tiết chuyến bay
                </div>

            </div>

            <!-- AIRLINE -->

            <div class="airline-box">

                <img 
                    src="<%= flight.airlineLogo %>"
                    style="
                        width:90px;
                        margin-bottom:15px;
                        object-fit:contain;
                    "
                >

                <div class="airline-name">
                    <%= flight.airlineName %>
                </div>

                <div class="flight-route">
                    <%= flight.fromCode %> → <%= flight.toCode %>
                </div>

                <div class="tag">
                    <%= flight.stops === 0 ? 'Bay thẳng' : flight.stops + ' điểm dừng' %>
                </div>

            </div>

            <!-- TIME -->

            <div class="flight-time-box">

                <div>

                    <div class="time">
                        <%= flight.departureTime %>
                    </div>

                    <div class="airport">
                        <%= flight.fromCode %>
                    </div>

                </div>

                <div class="flight-line"></div>

                <div style="text-align:right;">

                    <div class="time">
                        <%= flight.arrivalTime %>
                    </div>

                    <div class="airport">
                        <%= flight.toCode %>
                    </div>

                </div>

            </div>

            <!-- INFO -->

            <div class="info-row">

                <div class="info-label">
                    Hãng bay
                </div>

                <div class="info-value">
                    <%= flight.airlineName %>
                </div>

            </div>

            <div class="info-row">

                <div class="info-label">
                    Hành trình
                </div>

                <div class="info-value">
                    <%= flight.fromCode %> → <%= flight.toCode %>
                </div>

            </div>

            <div class="info-row">

                <div class="info-label">
                    Thời gian bay
                </div>

                <div class="info-value">
                    <%= flight.duration %>
                </div>

            </div>

            <div class="info-row">

                <div class="info-label">
                    Hạng ghế
                </div>

                <div class="info-value">
                    <%= flight.class || 'Economy' %>
                </div>

            </div>

            <!-- PRICE -->

            <div class="price-box">

                <div class="price-label">
                    Tổng thanh toán
                </div>

                <div class="price">
                    <%= flight.price.toLocaleString('vi-VN') %> VND
                </div>

            </div>

        </div>

    </div>

</div>