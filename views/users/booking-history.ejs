<%- include('../partials/header') %>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Inter',sans-serif;
}

body{
    background:#f5f7fa;
}

/* CONTAINER */

.history-wrapper{
    max-width:1200px;
    margin:140px auto 60px;
    padding:0 20px;
}

/* HEADER */

.page-header{
    margin-bottom:35px;
}

.page-title{
    font-size:38px;
    font-weight:800;
    color:#0f172a;
    margin-bottom:10px;
}

.page-subtitle{
    color:#64748b;
    font-size:15px;
}

/* CARD */

.booking-card{
    background:white;
    border-radius:24px;
    overflow:hidden;
    margin-bottom:28px;
    box-shadow:
        0 10px 30px rgba(15,23,42,0.06);
    border:1px solid #edf2f7;
}

/* TOP */

.card-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:28px 32px;
    background:
        linear-gradient(
            135deg,
            #0194f3,
            #0ea5e9
        );
    color:white;
}

.hotel-info h2{
    font-size:30px;
    font-weight:800;
    margin-bottom:8px;
}

.hotel-location{
    opacity:0.95;
    font-size:14px;
}

.booking-status{
    background:white;
    color:#16a34a;
    padding:10px 18px;
    border-radius:999px;
    font-size:14px;
    font-weight:700;
}

/* BODY */

.card-body{
    padding:30px;
}

/* GRID */

.booking-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.info-box{
    background:#f8fafc;
    border-radius:16px;
    padding:18px;
    border:1px solid #e2e8f0;
}

.info-label{
    font-size:13px;
    color:#64748b;
    margin-bottom:10px;
    font-weight:600;
}

.info-value{
    font-size:18px;
    font-weight:700;
    color:#0f172a;
}

/* PRICE */

.total-section{
    margin-top:28px;
    padding-top:25px;
    border-top:1px dashed #cbd5e1;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.total-label{
    font-size:20px;
    font-weight:700;
    color:#334155;
}

.total-price{
    font-size:34px;
    font-weight:800;
    color:#ff5e1f;
}

/* BUTTONS */

.action-row{
    display:flex;
    gap:16px;
    margin-top:30px;
}

.btn{
    flex:1;
    text-align:center;
    padding:16px;
    border-radius:14px;
    font-weight:700;
    text-decoration:none;
    transition:0.25s;
}

.btn-primary{
    background:#0194f3;
    color:white;
}

.btn-primary:hover{
    background:#0284c7;
    transform:translateY(-2px);
}

.btn-outline{
    border:2px solid #0194f3;
    color:#0194f3;
    background:white;
}

.btn-outline:hover{
    background:#f0f9ff;
}

/* EMPTY */

.empty-box{
    background:white;
    border-radius:24px;
    padding:80px 40px;
    text-align:center;
    box-shadow:0 4px 20px rgba(0,0,0,0.05);
}

.empty-box h2{
    margin-top:20px;
    font-size:28px;
    color:#0f172a;
}

.empty-box p{
    margin-top:10px;
    color:#64748b;
}

@media(max-width:768px){

    .booking-grid{
        grid-template-columns:1fr;
    }

    .card-top{
        flex-direction:column;
        align-items:flex-start;
        gap:20px;
    }

    .total-section{
        flex-direction:column;
        align-items:flex-start;
        gap:10px;
    }

    .action-row{
        flex-direction:column;
    }

    .page-title{
        font-size:30px;
    }

}

</style>

<div class="history-wrapper">

    <div class="page-header">

        <div class="page-title">
            Lịch sử đặt phòng
        </div>

        <div class="page-subtitle">
            Quản lý và xem lại tất cả booking của bạn
        </div>

    </div>

    <% if(bookings.length > 0){ %>

        <% bookings.forEach(booking => { %>

            <div class="booking-card">

                <!-- TOP -->
                <div class="card-top">

                    <div class="hotel-info">

                        <h2>
                            <%= booking.hotelName %>
                        </h2>

                        <div class="hotel-location">
                            Đà Nẵng, Việt Nam
                        </div>

                    </div>

                    <div class="booking-status">
                        ✔ <%= booking.status %>
                    </div>

                </div>

                <!-- BODY -->
                <div class="card-body">

                    <div class="booking-grid">

                        <div class="info-box">
                            <div class="info-label">
                                Mã đặt phòng
                            </div>

                            <div class="info-value">
                                <%= booking.bookingId %>
                            </div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">
                                Khách hàng
                            </div>

                            <div class="info-value">
                                <%= booking.guestName %>
                            </div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">
                                Ngày nhận phòng
                            </div>

                            <div class="info-value">
                                <%= booking.checkIn %>
                            </div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">
                                Ngày trả phòng
                            </div>

                            <div class="info-value">
                                <%= booking.checkOut %>
                            </div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">
                                Số đêm
                            </div>

                            <div class="info-value">
                                <%= booking.nights %> đêm
                            </div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">
                                Số khách
                            </div>

                            <div class="info-value">
                                <%= booking.guests %> người
                            </div>
                        </div>

                    </div>

                    <!-- TOTAL -->
                    <div class="total-section">

                        <div class="total-label">
                            Tổng thanh toán
                        </div>

                        <div class="total-price">
                            <%= booking.totalPrice.toLocaleString('vi-VN') %> VND
                        </div>

                    </div>

                    <!-- BUTTON -->
                    <div class="action-row">

                        <a href="/hotels/<%= booking.hotelId %>" class="btn btn-primary">
                            Xem khách sạn
                        </a>

                        <a href="/hotels" class="btn btn-outline">
                            Đặt thêm phòng
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    <% } else { %>

        <div class="empty-box">

            <div style="font-size:80px;">
                🏨
            </div>

            <h2>
                Chưa có lịch sử đặt phòng
            </h2>

            <p>
                Hãy khám phá và đặt khách sạn đầu tiên của bạn
            </p>

        </div>

    <% } %>

</div>