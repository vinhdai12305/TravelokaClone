<%- include('../partials/header') %>

<style>

body{
    background:#f5f7fa;
    font-family:Arial;
}

.history-container{
    max-width:1200px;
    margin:130px auto 60px;
}

.page-title{
    font-size:42px;
    font-weight:800;
    margin-bottom:35px;
    color:#0f172a;
}

.booking-card{
    background:white;
    border-radius:24px;
    padding:28px;
    margin-bottom:25px;
    box-shadow:0 5px 20px rgba(0,0,0,0.05);
    border:1px solid #eef2f7;
}

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.airline{
    font-size:30px;
    font-weight:800;
    color:#0f172a;
}

.code{
    background:#eff6ff;
    color:#2563eb;
    padding:10px 18px;
    border-radius:999px;
    font-weight:700;
}

.route{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:35px 0;
}

.airport{
    font-size:38px;
    font-weight:800;
    color:#0f172a;
}

.time{
    color:#64748b;
    font-size:15px;
    margin-top:8px;
}

.line{
    flex:1;
    height:2px;
    background:#cbd5e1;
    margin:0 25px;
    position:relative;
}

.line::after{
    content:'✈';
    position:absolute;
    right:-10px;
    top:-13px;
    color:#0194f3;
    font-size:22px;
}

.info-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
    margin-top:30px;
}

.info-box{
    background:#f8fafc;
    padding:18px;
    border-radius:16px;
}

.label{
    color:#64748b;
    font-size:14px;
    margin-bottom:8px;
}

.value{
    font-weight:800;
    color:#0f172a;
    font-size:17px;
}

.price{
    color:#ff5e1f;
    font-size:32px;
}

.status{
    color:#16a34a;
}

.empty{
    background:white;
    padding:80px;
    border-radius:24px;
    text-align:center;
    font-size:22px;
    color:#64748b;
}

</style>

<div class="history-container">

    <div class="page-title">
        Lịch sử đặt vé máy bay
    </div>

    <% if(bookings.length > 0){ %>

        <% bookings.forEach(booking=>{ %>

            <div class="booking-card">

                <!-- TOP -->

                <div class="top">

                    <div class="airline">
                        <%= booking.airlineName %>
                    </div>

                    <div class="code">
                        <%= booking.bookingCode %>
                    </div>

                </div>

                <!-- ROUTE -->

                <div class="route">

                    <div>

                        <div class="airport">
                            <%= booking.fromCode %>
                        </div>

                        <div class="time">
                            <%= booking.departureTime %>
                        </div>

                    </div>

                    <div class="line"></div>

                    <div style="text-align:right;">

                        <div class="airport">
                            <%= booking.toCode %>
                        </div>

                        <div class="time">
                            <%= booking.arrivalTime %>
                        </div>

                    </div>

                </div>

                <!-- INFO -->

                <div class="info-grid">

                    <div class="info-box">

                        <div class="label">
                            Hành khách
                        </div>

                        <div class="value">
                            <%= booking.guestName %>
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="label">
                            Số điện thoại
                        </div>

                        <div class="value">
                            <%= booking.phone %>
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="label">
                            Hạng ghế
                        </div>

                        <div class="value">
                            <%= booking.seatClass %>
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="label">
                            Số hành khách
                        </div>

                        <div class="value">
                            <%= booking.passengers %>
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="label">
                            Trạng thái
                        </div>

                        <div class="value status">
                            <%= booking.status %>
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="label">
                            Tổng tiền
                        </div>

                        <div class="value price">
                            <%= booking.totalPrice.toLocaleString('vi-VN') %> VND
                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    <% }else{ %>

        <div class="empty">
            Chưa có lịch sử đặt vé
        </div>

    <% } %>

</div>