<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>

  <!-- ICON -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<body style="
  margin:0;
  font-family:Arial, sans-serif;
  background:#f4f7fb;
  display:flex;
">

  <!-- SIDEBAR -->
  <div style="
    width:260px;
    height:100vh;
    background:white;
    border-right:1px solid #e2e8f0;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
  ">

    <!-- TOP -->
    <div>

      <!-- LOGO -->
      <div style="
        padding:35px 30px;
      ">
        <h2 style="
          margin:0;
          color:#0f172a;
          font-size:30px;
        ">
          +84Booking
        </h2>

        <p style="
          margin-top:5px;
          color:#94a3b8;
          letter-spacing:2px;
          font-size:12px;
        ">
          .COM
        </p>
      </div>

      <!-- MENU -->
      <div style="
        margin-top:20px;
        display:flex;
        flex-direction:column;
      ">

        <!-- ACTIVE -->
        <a href="/admin" style="
          padding:18px 30px;
          text-decoration:none;
          color:#0f172a;
          background:#f1f5f9;
          border-right:4px solid #0f4c81;
          display:flex;
          align-items:center;
          gap:15px;
          font-weight:bold;
        ">
          <i class="fa-solid fa-table-columns"></i>
          Dashboard
        </a>

        <a href="/admin/hotels" style="
          padding:18px 30px;
          text-decoration:none;
          color:#64748b;
          display:flex;
          align-items:center;
          gap:15px;
        ">
          <i class="fa-solid fa-hotel"></i>
          Hotels
        </a>

        <a href="/admin/airports" style="
          padding:18px 30px;
          text-decoration:none;
          color:#64748b;
          display:flex;
          align-items:center;
          gap:15px;
        ">
          <i class="fa-solid fa-plane-departure"></i>
          Airports
        </a>

        <a href="/admin/flights" style="
          padding:18px 30px;
          text-decoration:none;
          color:#64748b;
          display:flex;
          align-items:center;
          gap:15px;
        ">
          <i class="fa-solid fa-plane"></i>
          Flights
        </a>


      </div>

    </div>

    <!-- BOTTOM -->
    <div style="
      padding:30px;
      display:flex;
      flex-direction:column;
      gap:20px;
    ">

      <a href="#" style="
        text-decoration:none;
        color:#64748b;
        display:flex;
        align-items:center;
        gap:12px;
      ">
        <i class="fa-regular fa-circle-question"></i>
        Support
      </a>

      <a href="/logout" style="
        text-decoration:none;
        color:#64748b;
        display:flex;
        align-items:center;
        gap:12px;
      ">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        Logout
      </a>

    </div>

  </div>

  <!-- MAIN CONTENT -->
 <div style="
  flex:1;
  padding:30px 40px;
  background:#c7dbf6;
  min-height:100vh;
">

    <!-- TOPBAR -->
<div style="
  display:flex;
  justify-content:flex-end;
  align-items:center;
  margin-bottom:40px;
">

  <!-- PROFILE -->
  <div style="
    display:flex;
    align-items:center;
    gap:20px;
  ">

    <i class="fa-regular fa-bell" style="
      font-size:20px;
      color:#0f172a;
    "></i>

    <i class="fa-solid fa-gear" style="
      font-size:20px;
      color:#0f172a;
    "></i>

    <div style="
      display:flex;
      align-items:center;
      gap:12px;
    ">

      <div style="text-align:right;">

        <h4 style="
          margin:0;
          color:#0f172a;
        ">
          <%= user.username %>
        </h4>

        <p style="
          margin:3px 0 0;
          font-size:12px;
          color:#94a3b8;
          letter-spacing:1px;
        ">
          Admin
        </p>

      </div>

      <div style="
  width:50px;
  height:50px;
  border-radius:50%;
  background:#2563eb;
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  font-weight:700;
  text-transform:uppercase;
">
  <%= user && user.username
      ? user.username.charAt(0)
      : 'G'
  %>
</div>
    </div>

  </div>

</div>

    <!-- TITLE -->
    <div>
      <h1 style="
        margin:0;
        font-size:50px;
        color:#0f172a;
      ">
         Welcome back, <%= user ? user.username : 'Guest' %>
      </h1>

      <p style="
        margin-top:15px;
        color:#64748b;
        font-size:20px;
        width:800px;
        line-height:1.6;
      ">
        Manage your global elite travel operations with precision.
        Your overview of current system health and itinerary performance.
      </p>
    </div>

    <!-- STATISTICS -->
    <div style="
      display:flex;
      gap:25px;
      margin-top:40px;
      flex-wrap:wrap;
    ">

      <!-- CARD -->
      <div style="
        background:white;
        width:240px;
        padding:30px;
        border-radius:20px;
      ">

        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
        ">
          <div style="
            width:60px;
            height:60px;
            background:#dbeafe;
            border-radius:15px;
            display:flex;
            justify-content:center;
            align-items:center;
          ">
            <i class="fa-solid fa-hotel"
              style="font-size:25px; color:#0f4c81;"></i>
          </div>

        
        </div>

        <p style="
          margin-top:25px;
          color:#64748b;
          letter-spacing:2px;
          font-weight:bold;
        ">
          TOTAL HOTELS
        </p>

        <h1 style="
          margin-top:10px;
          color:#0f172a;
          font-size:50px;
        ">
          <%= totalHotels %>
        </h1>

      </div>

      <!-- USERS -->
      <div style="
        background:white;
        width:240px;
        padding:30px;
        border-radius:20px;
      ">

        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
        ">
          <div style="
            width:60px;
            height:60px;
            background:#dbeafe;
            border-radius:15px;
            display:flex;
            justify-content:center;
            align-items:center;
          ">
            <i class="fa-solid fa-user"
              style="font-size:25px; color:#0f4c81;"></i>
          </div>

  
        </div>

        <p style="
          margin-top:25px;
          color:#64748b;
          letter-spacing:2px;
          font-weight:bold;
        ">
          ACTIVE USERS
        </p>

        <h1 style="
          margin-top:10px;
          color:#0f172a;
          font-size:50px;
        ">
          <%= totalUsers %>
        </h1>

      </div>

      <!-- AIRPORT -->
      <div style="
        background:white;
        width:240px;
        padding:30px;
        border-radius:20px;
      ">

        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
        ">
          <div style="
            width:60px;
            height:60px;
            background:#dbeafe;
            border-radius:15px;
            display:flex;
            justify-content:center;
            align-items:center;
          ">
            <i class="fa-solid fa-plane-departure"
              style="font-size:25px; color:#0f4c81;"></i>
          </div>

        </div>

        <p style="
          margin-top:25px;
          color:#64748b;
          letter-spacing:2px;
          font-weight:bold;
        ">
          TOTAL AIRPORTS
        </p>

        <h1 style="
          margin-top:10px;
          color:#0f172a;
          font-size:50px;
        ">
          <%= totalAirports %>
        </h1>

      </div>

      <!-- FLIGHTS -->
      <div style="
        background:white;
        width:240px;
        padding:30px;
        border-radius:20px;
      ">

        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
        ">
          <div style="
            width:60px;
            height:60px;
            background:#dbeafe;
            border-radius:15px;
            display:flex;
            justify-content:center;
            align-items:center;
          ">
            <i class="fa-solid fa-plane"
              style="font-size:25px; color:#0f4c81;"></i>
          </div>

        </div>

        <p style="
          margin-top:25px;
          color:#64748b;
          letter-spacing:2px;
          font-weight:bold;
        ">
          DAILY FLIGHTS
        </p>

        <h1 style="
          margin-top:10px;
          color:#0f172a;
          font-size:50px;
        ">
          <%= totalFlights %>
        </h1>

      </div>

    </div>

  </div>

</body>
</html>