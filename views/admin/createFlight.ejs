<form
action="/admin/flights/create"
method="POST"
style="padding:40px;"
>

  <!-- GRID -->
  <div style="
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
  ">

    <!-- AIRLINE NAME -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        AIRLINE NAME
      </label>

      <input
      type="text"
      name="airlineName"
      required
      placeholder="Vietnam Airlines"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- AIRLINE LOGO -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        AIRLINE LOGO URL
      </label>

      <input
      type="text"
      name="airlineLogo"
      required
      placeholder="https://..."
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- FROM CODE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        FROM CODE
      </label>

      <input
      type="text"
      name="fromCode"
      required
      placeholder="DAD"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- TO CODE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        TO CODE
      </label>

      <input
      type="text"
      name="toCode"
      required
      placeholder="SGN"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- DEPARTURE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        DEPARTURE TIME
      </label>

      <input
      type="text"
      name="departureTime"
      required
      placeholder="08:00"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- ARRIVAL -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        ARRIVAL TIME
      </label>

      <input
      type="text"
      name="arrivalTime"
      required
      placeholder="09:30"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- STOPS -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        STOPS
      </label>

      <input
      type="number"
      name="stops"
      required
      placeholder="0"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- CLASS -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        CLASS
      </label>

      <select
      name="class"
      required
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
        background:white;
      ">

        <option value="Economy">Economy</option>
        <option value="Business">Business</option>
        <option value="First Class">First Class</option>

      </select>
    </div>

    <!-- DURATION -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        DURATION
      </label>

      <input
      type="text"
      name="duration"
      required
      placeholder="1h 30m"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- PRICE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        PRICE
      </label>

      <input
      type="number"
      name="price"
      required
      placeholder="2686706"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

  </div>

  <!-- BUTTONS -->
  <div style="
    margin-top:40px;
    display:flex;
    gap:20px;
  ">

    <button type="submit"
    style="
      height:60px;
      padding:0 30px;
      border:none;
      border-radius:18px;
      background:#0f4c81;
      color:white;
      font-size:18px;
      font-weight:700;
      cursor:pointer;
    ">
      + Create Flight
    </button>

    <a href="/admin/flights"
    style="
      height:60px;
      padding:0 30px;
      border-radius:18px;
      background:#e2e8f0;
      color:#0f172a;
      text-decoration:none;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:18px;
      font-weight:700;
    ">
      Cancel
    </a>

  </div>

</form>