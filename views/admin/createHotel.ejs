<form
action="/admin/hotels/create"
method="POST"
enctype="multipart/form-data"
style="padding:40px;"
>

  <!-- GRID -->
  <div style="
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
  ">

    <!-- HOTEL NAME -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        HOTEL NAME
      </label>

      <input
      type="text"
      name="name"
      required
      placeholder="Enter hotel name"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- LOCATION -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        LOCATION
      </label>

      <input
      type="text"
      name="location"
      required
      placeholder="Enter location"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- STARS -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        STARS
      </label>

      <input
      type="number"
      name="stars"
      required
      placeholder="Enter star rating"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- RATING -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        RATING
      </label>

      <input
      type="number"
      step="0.1"
      name="rating"
      required
      placeholder="Enter rating"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- REVIEW COUNT -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        REVIEW COUNT
      </label>

      <input
      type="text"
      name="reviewCount"
      required
      placeholder="Enter review count"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- DISCOUNT PRICE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        DISCOUNT PRICE
      </label>

      <input
      type="number"
      name="discountPrice"
      required
      placeholder="Enter discount price"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- TAG -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        TAG
      </label>

      <input
      type="text"
      name="tag"
      required
      placeholder="Enter tag"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- TYPE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        TYPE
      </label>

      <select
      name="type"
      required
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
        <option value="hotel">Hotel</option>
        <option value="resort">Resort</option>
        <option value="villa">Villa</option>
        <option value="apartment">Apartment</option>

      </select>
    </div>

    <!-- AMENITIES -->
<div style="grid-column:1/3;">

  <label style="
    display:block;
    margin-bottom:16px;
    font-weight:700;
    color:#64748b;
  ">
    AMENITIES
  </label>

  <div style="
    display:flex;
    flex-wrap:wrap;
    gap:16px;
  ">

    <!-- WIFI -->
    <label style="
      display:flex;
      align-items:center;
      gap:10px;
      background:#f8fafc;
      border:1px solid #dbe2ea;
      padding:14px 18px;
      border-radius:14px;
      cursor:pointer;
      font-weight:600;
      color:#0f172a;
    ">
      <input type="checkbox" name="amenities" value="wifi">
      Wifi
    </label>

    <!-- POOL -->
    <label style="
      display:flex;
      align-items:center;
      gap:10px;
      background:#f8fafc;
      border:1px solid #dbe2ea;
      padding:14px 18px;
      border-radius:14px;
      cursor:pointer;
      font-weight:600;
      color:#0f172a;
    ">
      <input type="checkbox" name="amenities" value="pool">
      Pool
    </label>

    <!-- RESTAURANT -->
    <label style="
      display:flex;
      align-items:center;
      gap:10px;
      background:#f8fafc;
      border:1px solid #dbe2ea;
      padding:14px 18px;
      border-radius:14px;
      cursor:pointer;
      font-weight:600;
      color:#0f172a;
    ">
      <input type="checkbox" name="amenities" value="restaurant">
      Restaurant
    </label>

    <!-- GYM -->
    <label style="
      display:flex;
      align-items:center;
      gap:10px;
      background:#f8fafc;
      border:1px solid #dbe2ea;
      padding:14px 18px;
      border-radius:14px;
      cursor:pointer;
      font-weight:600;
      color:#0f172a;
    ">
      <input type="checkbox" name="amenities" value="gym">
      Gym
    </label>

    <!-- SPA -->
    <label style="
      display:flex;
      align-items:center;
      gap:10px;
      background:#f8fafc;
      border:1px solid #dbe2ea;
      padding:14px 18px;
      border-radius:14px;
      cursor:pointer;
      font-weight:600;
      color:#0f172a;
    ">
      <input type="checkbox" name="amenities" value="spa">
      Spa
    </label>

  </div>

</div>

    <!-- IMAGE -->
    <div style="grid-column:1/3;">
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        HOTEL IMAGE
      </label>

      <input
      type="file"
      name="image"
      required
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:14px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

  </div>

  <!-- BUTTONS -->
  <div style="
    margin-top:40px;
    display:flex;
    gap:20px;
  ">

    <button type="submit"
    style="
      height:60px;
      padding:0 30px;
      border:none;
      border-radius:18px;
      background:#0f4c81;
      color:white;
      font-size:18px;
      font-weight:700;
      cursor:pointer;
    ">
      + Create Hotel
    </button>

    <a href="/admin/hotels"
    style="
      height:60px;
      padding:0 30px;
      border-radius:18px;
      background:#e2e8f0;
      color:#0f172a;
      text-decoration:none;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:18px;
      font-weight:700;
    ">
      Cancel
    </a>

  </div>

</form>