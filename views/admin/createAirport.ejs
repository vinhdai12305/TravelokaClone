<form
action="/admin/airports/create"
method="POST"
style="padding:40px;"
>

  <!-- GRID -->
  <div style="
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
  ">

    <!-- AIRPORT CODE -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        AIRPORT CODE
      </label>

      <input
      type="text"
      name="code"
      required
      placeholder="VD: JFK"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- AIRPORT NAME -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        AIRPORT NAME
      </label>

      <input
      type="text"
      name="name"
      required
      placeholder="Enter airport name"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- CITY -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        CITY
      </label>

      <input
      type="text"
      name="city"
      required
      placeholder="Enter city"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    <!-- COUNTRY -->
    <div>
      <label style="
        display:block;
        margin-bottom:10px;
        font-weight:700;
        color:#64748b;
      ">
        COUNTRY
      </label>

      <input
      type="text"
      name="country"
      required
      placeholder="Enter country"
      style="
        width:100%;
        height:60px;
        border:1px solid #dbe2ea;
        border-radius:16px;
        padding:0 18px;
        font-size:16px;
        box-sizing:border-box;
      ">
    </div>

    
  <!-- BUTTONS -->
  <div style="
    margin-top:40px;
    display:flex;
    gap:20px;
  ">

    <button type="submit"
    style="
      height:60px;
      padding:0 30px;
      border:none;
      border-radius:18px;
      background:#0f4c81;
      color:white;
      font-size:18px;
      font-weight:700;
      cursor:pointer;
    ">
      + Create Airport
    </button>

    <a href="/admin/airports"
    style="
      height:60px;
      padding:0 30px;
      border-radius:18px;
      background:#e2e8f0;
      color:#0f172a;
      text-decoration:none;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:18px;
      font-weight:700;
    ">
      Cancel
    </a>

  </div>

</form>