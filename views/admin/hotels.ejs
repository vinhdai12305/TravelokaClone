<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Hotels</title>

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
</head>

<body style="
margin:0;
font-family:Arial;
background:#f5f7fb;
">

<div style="display:flex; min-height:100vh;">

    <!-- SIDEBAR -->
    <div style="
    width:260px;
    background:linear-gradient(180deg,#0f172a,#111827);
    color:white;
    padding:30px;
    box-sizing:border-box;
    ">

        <h1 style="
        margin:0;
        font-size:48px;
        font-weight:800;
        ">
            ADMIN
        </h1>

        <div style="margin-top:60px;">

            <a href="/admin"
            style="
            display:flex;
            align-items:center;
            gap:12px;
            color:white;
            text-decoration:none;
            padding:16px 18px;
            border-radius:16px;
            background:rgba(255,255,255,0.08);
            margin-bottom:18px;
            ">
                <i class="fa-solid fa-chart-line"></i>
                Dashboard
            </a>

            <a href="/admin/hotels"
            style="
            display:flex;
            align-items:center;
            gap:12px;
            color:white;
            text-decoration:none;
            padding:16px 18px;
            border-radius:16px;
            background:#2563eb;
            ">
                <i class="fa-solid fa-hotel"></i>
                Hotels
            </a>

        </div>

    </div>

    <!-- CONTENT -->
    <div style="
    flex:1;
    padding:50px;
    ">

        <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:40px;
        ">

            <div>
                <h1 style="
                margin:0;
                font-size:56px;
                color:#0f172a;
                ">
                    Hotels
                </h1>

                <p style="
                color:#64748b;
                font-size:22px;
                ">
                    Manage all hotels
                </p>
            </div>

            <a href="/admin/hotels/create"
            style="
            background:#2563eb;
            color:white;
            padding:16px 26px;
            border-radius:16px;
            text-decoration:none;
            font-size:20px;
            font-weight:600;
            ">
                + Add Hotel
            </a>

        </div>

        <!-- HOTEL LIST -->
        <div style="
        display:grid;
        grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
        gap:30px;
        ">

            <% hotels.forEach(hotel => { %>

                <div style="
                background:white;
                border-radius:24px;
                overflow:hidden;
                box-shadow:0 10px 30px rgba(0,0,0,0.08);
                ">

                    <img
                    src="/uploads/<%= hotel.image %>"
                    style="
                    width:100%;
                    height:240px;
                    object-fit:cover;
                    ">

                    <div style="padding:24px;">

                        <h2 style="
                        margin:0 0 10px;
                        color:#0f172a;
                        ">
                            <%= hotel.name %>
                        </h2>

                        <p style="
                        color:#64748b;
                        margin-bottom:10px;
                        ">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= hotel.location %>
                        </p>

                        <h3 style="
                        color:#2563eb;
                        margin:0;
                        ">
                            $<%= hotel.price %> / night
                        </h3>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</div>

</body>
</html>