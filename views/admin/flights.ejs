<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Flights Admin</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,sans-serif;
  background:#f4f7fb;
  display:flex;
}

.flight-card:hover{
  transform:translateY(-5px);
  transition:0.3s;
}

</style>

<script>

function toggleMenu(id){

  document.querySelectorAll('[id^="menu-"]').forEach(menu => {

    if(menu.id !== id){
      menu.style.display = 'none';
    }

  });

  const menu = document.getElementById(id);

  if(menu.style.display === 'block'){
    menu.style.display = 'none';
  }else{
    menu.style.display = 'block';
  }

}

document.addEventListener('click', function(e){

  if(!e.target.closest('[onclick^="toggleMenu"]') &&
     !e.target.closest('[id^="menu-"]')){

    document.querySelectorAll('[id^="menu-"]').forEach(menu => {
      menu.style.display = 'none';
    });

  }

});

</script>

</head>

<body>

<!-- SIDEBAR -->
<div style="
  width:260px;
  height:100vh;
  background:white;
  border-right:1px solid #e2e8f0;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:fixed;
  left:0;
  top:0;
">

  <!-- TOP -->
  <div>

    <!-- LOGO -->
    <div style="
      padding:35px 30px;
    ">
      <h2 style="
        margin:0;
        color:#0f172a;
        font-size:30px;
      ">
        +84Booking
      </h2>

      <p style="
        margin-top:5px;
        color:#94a3b8;
        letter-spacing:2px;
        font-size:12px;
      ">
        .COM
      </p>
    </div>

    <!-- MENU -->
    <div style="
      margin-top:20px;
      display:flex;
      flex-direction:column;
    ">

      <a href="/admin" style="
        padding:18px 30px;
        text-decoration:none;
        color:#64748b;
        display:flex;
        align-items:center;
        gap:15px;
      ">
        <i class="fa-solid fa-table-columns"></i>
        Dashboard
      </a>

      <a href="/admin/hotels" style="
        padding:18px 30px;
        text-decoration:none;
        color:#64748b;
        display:flex;
        align-items:center;
        gap:15px;
      ">
        <i class="fa-solid fa-hotel"></i>
        Hotels
      </a>

      <a href="/admin/airports" style="
        padding:18px 30px;
        text-decoration:none;
        color:#64748b;
        display:flex;
        align-items:center;
        gap:15px;
      ">
        <i class="fa-solid fa-plane-departure"></i>
        Airports
      </a>

      <!-- ACTIVE -->
      <a href="/admin/flights" style="
        padding:18px 30px;
        text-decoration:none;
        color:#0f172a;
        background:#f1f5f9;
        border-right:4px solid #0f4c81;
        display:flex;
        align-items:center;
        gap:15px;
        font-weight:bold;
      ">
        <i class="fa-solid fa-plane"></i>
        Flights
      </a>

    </div>

  </div>

  <!-- BOTTOM -->
  <div style="
    padding:30px;
    display:flex;
    flex-direction:column;
    gap:20px;
  ">

    <a href="#"
    style="
      text-decoration:none;
      color:#64748b;
      display:flex;
      align-items:center;
      gap:12px;
    ">
      <i class="fa-regular fa-circle-question"></i>
      Support
    </a>

    <a href="/users/logout"
    style="
      text-decoration:none;
      color:#64748b;
      display:flex;
      align-items:center;
      gap:12px;
    ">
      <i class="fa-solid fa-arrow-right-from-bracket"></i>
      Logout
    </a>

  </div>

</div>

<!-- MAIN -->
<div style="
  margin-left:260px;
  flex:1;
  padding:30px 40px;
  background:#c7dbf6;
  min-height:100vh;
">

  <!-- TOPBAR -->
  <div style="
    display:flex;
    justify-content:flex-end;
    align-items:center;
    margin-bottom:40px;
  ">

    <div style="
      display:flex;
      align-items:center;
      gap:20px;
    ">

      <i class="fa-regular fa-bell"
      style="
        font-size:20px;
        color:#0f172a;
      "></i>

      <i class="fa-solid fa-gear"
      style="
        font-size:20px;
        color:#0f172a;
      "></i>

      <!-- PROFILE -->
      <div style="
        display:flex;
        align-items:center;
        gap:12px;
      ">

        <div style="text-align:right;">

          <h4 style="
            margin:0;
            color:#0f172a;
          ">
            <%= user.username %>
          </h4>

          <p style="
            margin:3px 0 0;
            font-size:12px;
            color:#94a3b8;
            letter-spacing:1px;
          ">
            Admin
          </p>

        </div>

        <!-- AVATAR -->
        <div style="
          width:50px;
          height:50px;
          border-radius:50%;
          background:#2563eb;
          color:white;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:22px;
          font-weight:700;
          text-transform:uppercase;
        ">
          <%= user && user.username
              ? user.username.charAt(0)
              : 'A'
          %>
        </div>

      </div>

    </div>

  </div>

  <!-- HEADER -->
  <div style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:40px;
  ">

    <div>

      <h1 style="
        margin:0;
        font-size:60px;
        color:#0f172a;
      ">
        FLIGHT MANAGEMENT
      </h1>

    </div>

    <a href="/admin/flights/create"
    style="
      background:#0f4c81;
      color:white;
      padding:18px 32px;
      border-radius:18px;
      text-decoration:none;
      font-size:18px;
      font-weight:700;
      box-shadow:0 10px 30px rgba(15,76,129,0.2);
    ">
      + Add Flight
    </a>

  </div>

  <!-- FLIGHT GRID -->
  <div style="
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(420px,1fr));
    gap:30px;
  ">

    <% flights.forEach(flight => { %>

    <!-- CARD -->
    <div class="flight-card"
    style="
      background:white;
      border-radius:24px;
      padding:30px;
      box-shadow:0 10px 30px rgba(0,0,0,0.08);
      position:relative;
    ">

      <!-- ACTION -->
      <div style="
        position:absolute;
        top:24px;
        right:24px;
      ">

        <!-- BUTTON -->
        <button
          type="button"
          onclick="toggleMenu('menu-<%= flight._id %>')"
          style="
            border:none;
            background:none;
            color:#64748b;
            font-size:20px;
            cursor:pointer;
          "
        >
          <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>

        <!-- DROPDOWN -->
        <div
          id="menu-<%= flight._id %>"
          style="
            display:none;
            position:absolute;
            top:35px;
            right:0;
            background:white;
            border-radius:14px;
            box-shadow:0 10px 25px rgba(0,0,0,0.12);
            overflow:hidden;
            min-width:150px;
            z-index:999;
          "
        >

          <!-- EDIT -->
          <a
            href="/admin/flights/edit/<%= flight._id %>"
            style="
              display:flex;
              align-items:center;
              gap:12px;
              padding:14px 18px;
              text-decoration:none;
              color:#0f172a;
              font-size:15px;
              border-bottom:1px solid #f1f5f9;
            "
          >
            <i class="fa-solid fa-pen"></i>
            Edit
          </a>

          <!-- DELETE -->
          <form
            action="/admin/flights/delete/<%= flight._id %>"
            method="POST"
            style="margin:0;"
            onsubmit="return confirm('Delete this flight?')"
          >

            <button
              type="submit"
              style="
                width:100%;
                border:none;
                background:none;
                padding:14px 18px;
                text-align:left;
                cursor:pointer;
                color:#dc2626;
                font-size:15px;
                display:flex;
                align-items:center;
                gap:12px;
              "
            >
              <i class="fa-solid fa-trash"></i>
              Delete
            </button>

          </form>

        </div>

      </div>

      <!-- AIRLINE -->
      <div style="
        display:flex;
        align-items:center;
        gap:16px;
        margin-bottom:30px;
      ">

        <img
        src="<%= flight.airlineLogo %>"
        style="
          width:70px;
          height:70px;
          object-fit:contain;
        ">

        <div>

          <h2 style="
            margin:0;
            color:#0f172a;
          ">
            <%= flight.airlineName %>
          </h2>

          <p style="
            margin-top:8px;
            color:#64748b;
          ">
            <%= flight.class %>
          </p>

        </div>

      </div>

      <!-- FLIGHT INFO -->
      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:30px;
      ">

        <!-- FROM -->
        <div>

          <h1 style="
            margin:0;
            color:#0f172a;
          ">
            <%= flight.fromCode %>
          </h1>

          <p style="
            margin-top:8px;
            color:#64748b;
          ">
            <%= flight.departureTime %>
          </p>

        </div>

        <!-- CENTER -->
        <div style="text-align:center;">

          <p style="
            color:#64748b;
            margin-bottom:10px;
          ">
            <%= flight.duration %>
          </p>

          <i class="fa-solid fa-plane"
          style="
            color:#2563eb;
            font-size:20px;
          "></i>

          <p style="
            margin-top:10px;
            color:#64748b;
          ">
            <%= flight.stops %> stop
          </p>

        </div>

        <!-- TO -->
        <div>

          <h1 style="
            margin:0;
            color:#0f172a;
          ">
            <%= flight.toCode %>
          </h1>

          <p style="
            margin-top:8px;
            color:#64748b;
          ">
            <%= flight.arrivalTime %>
          </p>

        </div>

      </div>

      <!-- PRICE -->
      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
      ">

        <div>

          <p style="
            color:#64748b;
            margin-bottom:8px;
          ">
            Ticket Price
          </p>

          <h2 style="
            margin:0;
            color:#0f4c81;
            font-size:32px;
          ">
            <%= flight.price %> VND
          </h2>

        </div>

      </div>

    </div>

    <% }) %>

  </div>

</div>

</body>
</html>